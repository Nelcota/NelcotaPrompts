  "type": "module",
  "scripts": {
    "dev": "bun --bun react-router dev",
    "build": "bun --bun react-router build && bun --bun run scripts/precompress.ts",
    "start": "NODE_ENV=production bun --bun run server.ts",
    "migrate": "bun --bun run scripts/migrate.ts",
    "seed": "bun --bun run scripts/seed.ts",
    "lint": "oxlint",
    "typecheck": "bun --bun react-router typegen && bun --bun tsc",
    "reset-link": "bun --bun run scripts/reset-link.ts",
    "make-admin": "bun --bun run scripts/make-admin.ts"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
