    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "diff": "^9.0.0",
    "drizzle-orm": "^0.45.4",
    "embla-carousel": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "hono": "^4.13.13",
    "ipaddr.js": "^2.5.0",
    "isbot": "^5.1.36",
