# Conexão com o Postgres (formato postgres://usuario:senha@host:porta/banco)
DATABASE_URL=postgres://nelcota:nelcota@localhost:5432/nelcota_prompts

# Segredo que assina o cookie de sessão. Gere um valor longo e aleatório:
#   bun -e "console.log(crypto.randomUUID() + crypto.randomUUID())"
SESSION_SECRET=troque-por-um-valor-longo-e-aleatorio

# Código que os amigos precisam informar para criar conta
INVITE_CODE=meu-convite-secreto

# Porta HTTP do servidor de produção (server.ts)
PORT=3000

# Endereço público, usado no log de inicialização e nos links do reset-link. No Coolify,
# se ficar vazio, vale o domínio configurado no app.
# APP_URL=https://prompts.seudominio.com

# Opcional. Envio de email (Resend) para o "Esqueci minha senha". Sem isso, a página
# orienta a pedir o link a um admin. EMAIL_FROM precisa ser de um domínio verificado.
# RESEND_API_KEY=re_...
# EMAIL_FROM=Nelcota Prompts <nao-responda@seudominio.com>

# Opcional. Só se houver Cloudflare (proxy laranja) na frente do Coolify: com
# TRUSTED_PROXY=cloudflare o IP real vem do cabeçalho CF-Connecting-IP. Sem isso,
# vale o X-Forwarded-For do Traefik do Coolify.
# TRUSTED_PROXY=cloudflare
